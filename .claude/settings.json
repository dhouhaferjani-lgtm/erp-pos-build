{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/git-dev-push-guard.sh\"",
            "timeout": 20,
            "statusMessage": "dev-push-guard"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/git-stash-guard.sh\"",
            "timeout": 20,
            "statusMessage": "git-stash-guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/design-system-audit-hook.sh\"",
            "timeout": 45,
            "statusMessage": "design-system-audit"
          }
        ]
      }
    ]
  }
}

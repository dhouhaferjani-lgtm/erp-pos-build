includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
    level: 8

    # Exclude paths
    excludePaths:
        analyseAndScan:
            - app/Console/Kernel.php (?)
            - app/Http/Kernel.php (?)

    # Laravel specific
    checkModelProperties: true

    # Parallel processing - reduces per-worker memory by splitting work
    parallel:
        maximumNumberOfProcesses: 4
        processTimeout: 300.0

includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
    level: 8

    # Allow stale @phpstan-ignore annotations (pre-existing drift)
    reportUnmatchedIgnoredErrors: false

    # Exclude paths
    excludePaths:
        analyseAndScan:
            - app/Console/Kernel.php (?)
            - app/Http/Kernel.php (?)
            - app/Console/Commands/Test*.php
            - app/Console/Commands/MigrateParapharmacyDataCommand.php

    # Laravel specific
    checkModelProperties: true

    # Parallel processing - reduces per-worker memory by splitting work
    parallel:
        maximumNumberOfProcesses: 4
        processTimeout: 300.0

rules:
    - App\PHPStan\Rules\WorkOrderStatusWriteOnlyViaTransitionService

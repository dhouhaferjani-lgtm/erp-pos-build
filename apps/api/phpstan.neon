includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
    level: 8

    # Allow stale @phpstan-ignore annotations (pre-existing drift)
    reportUnmatchedIgnoredErrors: false

    # Exclude paths
    excludePaths:
        analyseAndScan:
            - app/Console/Kernel.php (?)
            - app/Http/Kernel.php (?)
            - app/Console/Commands/Test*.php
            - app/Console/Commands/MigrateParapharmacyDataCommand.php

    # Laravel specific
    checkModelProperties: true

    # Parse the casts() method (not just the legacy $casts property) so the
    # decimal-cast precision rule can see decimal:* casts declared in casts().
    parseModelCastsMethod: true

    # Parallel processing - reduces per-worker memory by splitting work
    parallel:
        maximumNumberOfProcesses: 4
        processTimeout: 300.0

rules:
    - App\PHPStan\Rules\DeliveryNoteBillingWritesOnlyViaClaimService
    - App\PHPStan\Rules\WorkOrderStatusWriteOnlyViaTransitionService
    - App\PHPStan\Rules\DocumentStatusWriteOnlyViaStatusService
    - App\PHPStan\Rules\ForbidHardcodedBcmathScale
    - App\PHPStan\Rules\ForbidFixedScaleQuantityLiteralRule
    - App\PHPStan\Rules\ForbidQuantityScaleConstantInPresentationRule
    - App\PHPStan\Rules\InventoryGlPostingViaBufferOnly
    - App\PHPStan\Rules\InventoryPaymentRepositoryLockDisjointness

services:
    -
        class: App\PHPStan\Rules\ForbidFloatCastOnDecimalProperty
        tags:
            - phpstan.rules.rule

# =============================================================================
# AutoERP Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# IMPORTANT: After cloning, generate a new APP_KEY with: php artisan key:generate
# =============================================================================

APP_NAME=AutoERP
APP_ENV=local
APP_KEY=
# IMPORTANT: Set to false in production!
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Country Defaults remains inert until the two-stage deployment checklist is complete.
COUNTRY_DEFAULTS_PROVISIONING_ENABLED=false
COUNTRY_DEFAULTS_EXTERNAL_EDITORS_ENABLED=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# PostgreSQL with TimescaleDB
# Port 5433 to avoid conflicts with local PostgreSQL
# =============================================================================
# T6 Phase 0b — database-per-tenant. DB_CONNECTION=central makes the app default
# AND Stancl's central_connection (env('DB_CONNECTION','central')) resolve to the
# same `central` connection, which holds the central tables (tenants, domains,
# plans, tenant_subscriptions, super_admins, central_identities,
# personal_access_tokens). Stancl swaps the default connection to a per-tenant
# database mid-request; the `central` connection is never swapped.
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=5433
# Central database (holds the tenant directory + cross-tenant infra tables).
# Use a PRODUCT-named DB per deployment (e.g. iziposcentral / otospexcentral).
# Do NOT name it after the "synerivia" data platform — the ERP is a client of it.
DB_CENTRAL_DATABASE=iziposcentral
# Template database for the per-tenant connection (host/credentials reused; the
# actual per-tenant database name is tenant<uuid>, created by Stancl).
DB_DATABASE=autoerp
DB_USERNAME=autoerp
DB_PASSWORD=autoerp_secret
# Flip to true in any environment running real per-tenant databases so the
# pre-auth TenancyResolver fails closed (503) for an unprovisioned tenant.
TENANCY_DB_PER_TENANT=true

# =============================================================================
# PgBouncer (T6 Phase 0b — connection pooling for DB-per-tenant)
# =============================================================================
# Point DB_HOST / DB_PORT at the PgBouncer instance to enable pooling for
# normal request traffic. DB_PGBOUNCER=true also enables PDO::ATTR_EMULATE_PREPARES
# which is required in transaction-pool mode (the only mode that works with
# database-per-tenant, since Stancl swaps the default connection per request).
#
# CREATE/DROP DATABASE issued by signup/deprovision MUST bypass PgBouncer and
# talk directly to the backend Postgres. Either run those commands from a host
# whose DB_HOST points at Postgres directly, or maintain a separate ops env
# that does. See docs/operations/POST-FLIP-OPS.md.
DB_PGBOUNCER=false

# =============================================================================
# Per-tenant backups (T6 Phase 0b — A4.1)
# =============================================================================
# Root directory for pg_dump custom-format dumps. Each tenant gets a uuid
# subdirectory, each dump a timestamped filename. Defaults to
# storage/app/tenant-backups when unset.
# TENANT_BACKUP_ROOT=/var/backups/autoerp
# Number of most-recent successful backups retained per tenant after each
# tenant:backup completes. 0 keeps everything.
TENANT_BACKUP_KEEP=14

# =============================================================================
# Redis for cache, sessions, and queues
# Port 6380 to avoid conflicts with local Redis
# =============================================================================
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=autoerp_redis
REDIS_PORT=6380

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# =============================================================================
# Meilisearch
# =============================================================================
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=autoerp_meili_master_key

# =============================================================================
# MinIO (S3-compatible storage)
# =============================================================================
AWS_ACCESS_KEY_ID=autoerp_minio
AWS_SECRET_ACCESS_KEY=autoerp_minio_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=autoerp
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# =============================================================================
# Mail (log for development)
# =============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@autoerp.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# Sentry Error Tracking
# Get your DSN from: https://sentry.io/settings/projects/YOUR_PROJECT/keys/
# =============================================================================
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1

# =============================================================================
# Syneriva Platform Integration
# =============================================================================
SYNERIVA_PLATFORM_URL=http://localhost:8080
SYNERIVA_PLATFORM_API_KEY=
# set false on staging/test installs — test data must never enrich the production platform
SYNERIVA_PLATFORM_PUSH_ENABLED=true

# =============================================================================
# Scheduling module — storefront CAPTCHA
# Google reCAPTCHA v3 server-side secret. RECAPTCHA_MIN_SCORE is the floor
# below which submissions are rejected. RECAPTCHA_HOSTNAME is optional
# (leave blank to disable hostname pinning).
# =============================================================================
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_HOSTNAME=

# =============================================================================
# Marketplace kill-switch
# =============================================================================
# Master switch for the unreleased Marketplace module: gates its whole HTTP
# surface, the catalog-carts marketplace-checkout endpoint + marketplace cart
# items, and the two scheduled sync commands. LEAVE UNSET/false — the fleet
# admin surface is not tenant-safe yet (see
# docs/superpowers/tickets/2026-08-05-marketplace-admin-surface-redesign.md).
# Read at BOOT time: flipping it needs a container restart, because
# docker/entrypoint.sh bakes the route collection with `route:cache`.
MARKETPLACE_ENABLED=false

# Opt-in: at API boot, re-run RolesAndPermissionsSeeder across every tenant DB
# (tenants:seed --force). Propagates NEW permissions to existing tenants but
# RESETS built-in roles to the canonical set (custom roles untouched).
# Safe on staging; a product decision for production.
SYNC_PERMISSIONS_ON_BOOT=false

# =============================================================================
# Consent-gated support access
# Four-eyes ships enabled. Deployment must provide the business partner account
# and retain an explicit approver allow-list; an empty/malformed list fails closed.
# =============================================================================
SUPPORT_ACCESS_FOUR_EYES_ENABLED=true
SUPPORT_ACCESS_FOUR_EYES_SENSITIVE_TENANTS=true
SUPPORT_ACCESS_PARTNER_NAME="Business Partner Support Approver"
SUPPORT_ACCESS_PARTNER_EMAIL=support-approver@autoerp.local
SUPPORT_ACCESS_PARTNER_PASSWORD=
SUPPORT_ACCESS_APPROVER_EMAILS=support-approver@autoerp.local

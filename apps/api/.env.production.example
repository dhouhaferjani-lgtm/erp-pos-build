# =============================================================================
# AutoERP Production Environment Configuration
# =============================================================================
# For Dokploy deployment to erp.otospex.dev
# Copy values to Dokploy environment variables panel
# =============================================================================

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=AutoERP
APP_ENV=production
APP_KEY=
# CRITICAL: Must be false in production!
APP_DEBUG=false
APP_URL=https://erp.otospex.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Higher rounds for production security
BCRYPT_ROUNDS=12

# =============================================================================
# Logging (production settings)
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use 'warning' or 'error' in production
LOG_LEVEL=warning

# =============================================================================
# PostgreSQL Database
# =============================================================================
# In Dokploy, use the service name as host (e.g., 'postgres')
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=autoerp
DB_USERNAME=autoerp
# Generate a strong password: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# =============================================================================
# Redis (Cache, Sessions, Queues)
# =============================================================================
# In Dokploy, use the service name as host (e.g., 'redis')
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=erp.otospex.dev
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# =============================================================================
# Meilisearch
# =============================================================================
# In Dokploy, use the service name as host (e.g., 'meilisearch')
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
# Generate a strong master key: openssl rand -base64 32
MEILISEARCH_KEY=CHANGE_ME_MEILI_MASTER_KEY

# =============================================================================
# MinIO (S3-compatible storage)
# =============================================================================
# In Dokploy, use the service name as host (e.g., 'minio')
AWS_ACCESS_KEY_ID=autoerp_minio
AWS_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_SECRET
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=autoerp
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# =============================================================================
# Mail Configuration
# =============================================================================
# Use SMTP or a transactional email service like Mailgun, Postmark, SES
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@otospex.dev"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# Sentry Error Tracking
# =============================================================================
# Get your DSN from: https://sentry.io/settings/projects/YOUR_PROJECT/keys/
SENTRY_LARAVEL_DSN=
# Lower sample rates for production to reduce costs
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.05

# =============================================================================
# Laravel Horizon (Queue Management)
# =============================================================================
HORIZON_PREFIX=autoerp_horizon:

# =============================================================================
# Trusted Proxies (for Dokploy/Docker)
# =============================================================================
# Trust all proxies when behind load balancer/reverse proxy
TRUSTED_PROXIES=*

# =============================================================================
# CORS Settings
# =============================================================================
# Frontend URL for CORS
CORS_ALLOWED_ORIGINS=https://erp.otospex.dev

# =============================================================================
# Sanctum Settings
# =============================================================================
SANCTUM_STATEFUL_DOMAINS=erp.otospex.dev

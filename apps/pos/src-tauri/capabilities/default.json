{
  "identifier": "default",
  "description": "Default capabilities for IziPOS",
  "windows": ["main", "customer-display"],
  "permissions": [
    "core:default",
    "core:event:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*/**" },
        { "url": "https://*:*/**" },
        { "url": "http://*/**" },
        { "url": "https://*/**" }
      ]
    },
    "notification:default",
    "os:default",
    "window-state:default",
    "log:default",
    "fs:default",
    {
      "identifier": "fs:allow-appdata-read-recursive",
      "allow": [{ "path": "$APPDATA/images/**" }]
    },
    {
      "identifier": "fs:allow-appdata-write-recursive",
      "allow": [{ "path": "$APPDATA/images/**" }]
    }
  ]
}
